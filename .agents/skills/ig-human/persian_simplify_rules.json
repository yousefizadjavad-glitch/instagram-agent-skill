{
  "version": 1,
  "rules": [
    {
      "id": "fa-about",
      "pattern": "در خصوص(?= +(?:ارسال|زمان تحویل|مدل|موضوع|محصول|سفارش|ثبت‌نام|Export)(?![\\w‌]))",
      "replacement": "دربارهٔ",
      "reason": "صورت ساده‌تر برای بیان موضوع؛ بافت را بررسی کنید."
    },
    {
      "id": "fa-purpose",
      "pattern": "به منظور(?= +(?:بررسی|آزمایش|ثبت|ارسال|دریافت)(?![\\w‌]))",
      "replacement": "برای",
      "reason": "صورت کوتاه‌تر برای بیان هدف؛ رابطهٔ هدف را بررسی کنید."
    },
    {
      "id": "fa-email",
      "pattern": "از طریق ایمیل(?= +(?:ارسال|بفرست|دریافت)(?![\\w‌])| +ارسال کنید)",
      "replacement": "با ایمیل",
      "reason": "بیان ساده‌تر کانال ارسال در بافت محدود."
    },
    {
      "id": "fa-request",
      "pattern": "خواهشمند است (?P<object>(?:تصویر +رسید|فایل|رسید|شمارهٔ سفارش)) را ارسال فرمایید",
      "replacement": "لطفاً {object} را ارسال کنید",
      "reason": "درخواست مستقیم‌تر با حفظ خطاب جمع و احترام.",
      "tone_replacements": {
        "colloquial": "لطفاً {object} را بفرستید"
      }
    }
  ]
}
